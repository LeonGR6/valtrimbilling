{
  "name": "@valtrimbilling/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "link": "supabase link",
    "migration:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "db:lint": "supabase db lint --linked",
    "db:test": "node scripts/test-remote-db.mjs",
    "functions:new": "supabase functions new",
    "functions:deploy": "supabase functions deploy --use-api",
    "functions:check": "deno check --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock \"supabase/functions/**/*.ts\"",
    "functions:check-email-worker": "deno check --node-modules-dir=auto --config supabase/functions/customer-service-email-worker/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/customer-service-email-worker/index.ts",
    "functions:check-email-retry": "deno check --node-modules-dir=auto --config supabase/functions/customer-service-email-retry/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/customer-service-email-retry/index.ts",
    "functions:test-email-retry": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/_shared/customerServiceEmailRetry.test.ts",
    "functions:test-email-connection": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/_shared/customerServiceEmailConnection.test.ts",
    "functions:test-email-sync": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/_shared/customerServiceMicrosoftGraph.test.ts supabase/functions/_shared/customerServiceEmailSync.test.ts supabase/functions/_shared/customerServiceEmailSyncStorage.test.ts supabase/functions/_shared/customerServiceEmailSourceRecovery.test.ts supabase/functions/_shared/customerServiceGraphSourceStorage.test.ts",
    "functions:check-email-sync": "deno check --node-modules-dir=auto --config supabase/functions/customer-service-email-sync/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/customer-service-email-sync/index.ts",
    "functions:check-email-reconcile": "deno check --node-modules-dir=auto --config supabase/functions/customer-service-email-reconcile/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/customer-service-email-reconcile/index.ts",
    "functions:test-email-automation": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock --frozen-lockfile supabase/functions/_shared/customerServiceEmailScheduledDispatch.test.ts supabase/functions/_shared/customerServiceEmailReconcile.test.ts",
    "functions:test-appointments": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/_shared/customerServiceAppointments.test.ts supabase/functions/_shared/customerServiceAppointmentTransitions.test.ts supabase/functions/_shared/customerServiceTravel.test.ts supabase/functions/_shared/customerServiceTravelMatrix.test.ts",
    "functions:test-source-pdf": "deno test --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/_shared/customerServiceSourcePdf.test.ts",
    "functions:test-email-import": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/_shared/customerServiceEmailAttachments.test.ts supabase/functions/_shared/customerServiceEmailImportStorage.test.ts",
    "functions:test-email-analysis": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/_shared/customerServiceEmailSource.test.ts supabase/functions/_shared/customerServiceEmailIntake.test.ts supabase/functions/_shared/customerServiceEmailAnalysis.test.ts supabase/functions/_shared/customerServiceEmailExtraction.test.ts supabase/functions/_shared/mistralEmailImport.test.ts",
    "functions:test-email-worker": "deno test --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/_shared/customerServiceEmailWorker.test.ts supabase/functions/_shared/customerServiceEmailRuntime.test.ts supabase/functions/_shared/customerServiceGraphImageSource.test.ts supabase/functions/_shared/customerServiceGraphImageAnalysis.test.ts",
    "functions:test-customer-service-pdf": "deno run --node-modules-dir=auto --config supabase/functions/deno.json --lock supabase/functions/deno.lock --allow-env=API_KEY_MISTRAL_IA --allow-read --allow-write=supabase/.temp --allow-net=api.mistral.ai scripts/test-customer-service-pdf-extraction.ts",
    "types:gen": "supabase gen types typescript --linked --schema valtrim > supabase/functions/_shared/database.types.ts",
    "secrets:set": "supabase secrets set"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "2.116.0"
  }
}
