# Copy this file to .env and fill it in with the values from your own Supabase
# project (Dashboard -> Project Settings -> API). Each developer points at their
# own project, so .env is never committed -- only this example is.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only ever the ANON key here. Never the service role key.
#
# Anything prefixed with VITE_ is inlined into the JavaScript bundle and shipped
# to every browser that loads the app. The service role key bypasses RLS
# completely, so putting it here would hand every visitor -- and every field
# user -- unrestricted read access to pricing, invoices and draws.
#
# The service role key is only used inside Edge Functions, where Supabase
# injects it at runtime. It never needs to be written down anywhere.
